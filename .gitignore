node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*

# Built Mac apps and disk images. The download is attached to a GitHub Release
# rather than served from here, so no binary belongs in this repository at all.
# See CONTRIBUTING.md for the build commands.
*.dmg

# Firebase CLI deploy cache — rewritten on every deploy
.firebase/

# Xcode per-user window and editor state
xcuserdata/
*.xcuserstate

# /graphify knowledge-graph output — a derived snapshot of the code, rebuilt on
# demand with `/graphify . --update`. Nothing here is source.
graphify-out/

# Per-machine editor settings. Nothing here is shared config — the one file that
# appeared recorded an absolute path to a single developer's home directory.
.vscode/
